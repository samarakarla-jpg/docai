# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sprint 02 — somente desenvolvimento:
# Desabilite "Confirm email" apenas no projeto Supabase de desenvolvimento
# durante a validação do fluxo básico de cadastro.
#
# Requisito de produção:
# "Confirm email" deve permanecer habilitado no projeto Supabase de produção.
# Nunca use chaves secretas ou de service role em variáveis NEXT_PUBLIC.

# Sprint 07 — capacidades opcionais permanecem desativadas por padrão.
# Estes nomes documentam configuração futura no ambiente de servidor; não inclua valores reais.
# OPTIONAL_AI_ENABLED=false
# OPTIONAL_PAYMENTS_ENABLED=false
# OPTIONAL_PDF_ENABLED=false
# OPTIONAL_MAIL_ENABLED=false
# OPTIONAL_STORAGE_ENABLED=false
